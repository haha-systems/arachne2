// Medium Worker: Medium confidence, medium price.
// Run with agent-id=worker-medium

handle announce(msg) {
  print("MediumWorker received announce: " + msg.auction_id + " for task: " + msg.payload.task)
  let bid = {confidence: 0.85, price: 12}
  contract_net.submit_bid(msg.auction_id, "worker-medium", bid)
  print("MediumWorker submitted bid")
}

handle assign(msg) {
  print("MediumWorker assigned task! processing...")
  sleep(500)
  contract_net.complete(msg.auction_id, "worker-medium", {status: "success"})
  print("MediumWorker completed task")
}

act run() {
  print("MediumWorker started. Listening...")
  print("MediumWorker initialized")
  while true {
    sleep(1000)
  }
}

run()
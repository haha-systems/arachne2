// Slow Worker: Low confidence, high price.
// Run with agent-id=worker-slow

handle announce(msg) {
  print("SlowWorker received announce: " + msg.auction_id + " for task: " + msg.payload.task)
  let bid = {confidence: 0.7, price: 20}
  contract_net.submit_bid(msg.auction_id, "worker-slow", bid)
  print("SlowWorker submitted bid")
}

handle assign(msg) {
  print("SlowWorker assigned task! processing...")
  sleep(500)
  contract_net.complete(msg.auction_id, "worker-slow", {status: "success"})
  print("SlowWorker completed task")
}

act run() {
  print("SlowWorker started. Listening...")
  print("SlowWorker initialized")
  while true {
    sleep(1000)
  }
}

run()
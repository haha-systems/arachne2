// Cheap route-target worker for the adaptive router (Tier 3).
//
// Resident, tick-driven. Responds only to route_request messages addressed to
// the "cheap" route. Fast and inexpensive but low quality, so the router treats
// it as an available-but-uncertain fallback.

state route = "cheap"
state jobs_done = 0

fn complete(msg) {
  if msg.payload.kind == "route_request" {
    if msg.payload.route == route {
      let cycle = msg.payload.cycle
      sleep(3)
      jobs_done = jobs_done + 1
      contract_net.complete("route-done-" + cycle, organism.agent_id(), {
        kind: "route_done",
        route: route,
        cycle: cycle,
        latency_ms: 80,
        quality: 0.52,
        degraded: false
      })
    }
  }
}

// Steady route-target worker for the adaptive router (Tier 3).
//
// Resident, tick-driven. Responds only to route_request messages addressed to
// the "steady" route. Slower than the fast worker but robust across the
// non-stationary window: it is the route the router should shift to once the
// fast worker degrades.

state route = "steady"
state jobs_done = 0

fn complete(msg) {
  if msg.payload.kind == "route_request" {
    if msg.payload.route == route {
      let cycle = msg.payload.cycle
      sleep(8)
      jobs_done = jobs_done + 1
      contract_net.complete("route-done-" + cycle, organism.agent_id(), {
        kind: "route_done",
        route: route,
        cycle: cycle,
        latency_ms: 150,
        quality: 0.84,
        degraded: false
      })
    }
  }
}

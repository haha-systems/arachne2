// Minimal Phase 2 Silk active-inference authoring cycle.
// Run from the repo root with:
//   zig build run -- run examples/active_inference_minimal.silk
// or, with mise-managed tools:
//   mise exec -- zig build run -- run examples/active_inference_minimal.silk

capability "examples.active_inference.minimal" {
  topics = ["ai.prediction_error.v1"]
  tools = ["active_inference"]
}

active_inference.reset()

state belief = active_inference.declare_belief({
  belief_id: "belief-minimal-reviewer-latency",
  claim: "bounded reviewer usually finishes within its predicted latency",
  scope: "routing",
  owner: "examples.active_inference.minimal",
  confidence: 0.60,
  provenance: "examples/active_inference_minimal.silk"
})

state prediction = active_inference.record_prediction({
  prediction_id: "pred-minimal-reviewer-latency",
  belief_id: belief.belief_id,
  task_id: "task-minimal-review",
  action_id: "act-request-review",
  expected_agent_or_procedure: "reviewer-gate",
  expected_success: true,
  expected_latency_ms: 100,
  expected_quality: 0.80,
  confidence_at_prediction: belief.confidence,
  timestamp_ms: 1000
})

learn reconcile_minimal(outcome) {
  let contract = active_inference.learn_contract({
    contract_id: "contract-minimal-reviewer-latency",
    observed_signals: ["observation", "prediction_error"],
    belief_ids: [belief.belief_id],
    prediction_ids: [prediction.prediction_id],
    state_touched: ["belief.confidence", "belief.promotion_status"],
    update_rule: "timeout",
    rationale: "a timeout prediction error lowers only this local Episodic routing belief",
    bounds: "confidence_delta:-0.20..0.05",
    safe_for: "episodic_only",
    allowed_surfaces: ["episodic.beliefs"],
    prohibited_surfaces: ["semantic_memory", "covenant", "governance_state", "user_config"],
    approval_required: false
  })

  let observation = active_inference.record_observation({
    observation_id: outcome.observation_id,
    prediction_id: prediction.prediction_id,
    task_id: "task-minimal-review",
    actual_agent_or_procedure: "reviewer-gate",
    observed_success: false,
    observed_latency_ms: 240,
    observed_quality: 0.40,
    error_message: "timeout waiting for reviewer-gate",
    timestamp_ms: 1100
  })

  let prediction_error = active_inference.compute_prediction_error({
    prediction_error_id: outcome.prediction_error_id,
    prediction_id: prediction.prediction_id,
    observation_id: observation.observation_id,
    impact: "routing"
  })

  let update = active_inference.apply_learn_update({
    contract_id: contract.contract_id,
    belief_id: belief.belief_id,
    prediction_error_id: prediction_error.prediction_error_id,
    timestamp_ms: 1200
  })

  return {contract: contract, observation: observation, prediction_error: prediction_error, update: update}
}

state result = reconcile_minimal({
  observation_id: "obs-minimal-review-timeout",
  prediction_error_id: "pe-minimal-review-timeout"
})

state learn_contract = result.contract
state observation = result.observation
state prediction_error = result.prediction_error
state update = result.update
state snapshot = active_inference.inspect()
state safety_counters = active_inference.safety_counters()
